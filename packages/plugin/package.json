{
  "name": "@gateforge/parrot-openclaw",
  "version": "0.1.0",
  "description": "GateForge Parrot 🦜 — zero-knowledge E2EE chat plugin for OpenClaw",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "ui-dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-test-module-mocks dist/**/*.test.js"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "gateforge",
    "parrot",
    "e2ee",
    "zero-knowledge",
    "encryption",
    "chat",
    "channel"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "Tony Lung <tonylnng@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonylnng/gateforge-parrot-openclaw.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/tonylnng/gateforge-parrot-openclaw#readme"
}
