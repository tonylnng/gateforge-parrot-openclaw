{
  "name": "@gateforge/parrot-sdk",
  "version": "0.1.0",
  "description": "Client SDK for GateForge Parrot — zero-knowledge E2EE chat over REST + SSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "gateforge",
    "parrot",
    "e2ee",
    "zero-knowledge",
    "chat",
    "sdk",
    "openclaw"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "author": "Tony Lung <tonylnng@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonylnng/gateforge-parrot-openclaw.git",
    "directory": "packages/parrot-sdk"
  },
  "homepage": "https://github.com/tonylnng/gateforge-parrot-openclaw#readme"
}
